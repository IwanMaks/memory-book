# --- API (apps/api) ---
# Локально: docker compose up -d postgres.
# В проде (Vercel): pooled-строка Neon (хост с `-pooler`), sslmode=verify-full, например
#   postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full
# Для миграций (секрет DATABASE_URL в GitHub Actions) бери direct-строку, без `-pooler`.
DATABASE_URL=postgres://memorybook:memorybook@localhost:5432/memorybook
PORT=3000
# Локально development. На Vercel НЕ задавай: с NODE_ENV=production сборка не поставит
# devDependencies, а entry.vercel.ts и так включает production (secure-cookie).
NODE_ENV=development
# Origin фронтенда (для CSRF). В проде: https://<домен web-проекта>, без слеша в конце.
APP_ORIGIN=http://localhost:5180
# Закрой регистрацию (false), когда создашь свой аккаунт
ALLOW_SIGNUP=true
# Необязательно: без ключа Google Books работает с жёсткими лимитами
GOOGLE_BOOKS_API_KEY=
