# --- API (apps/api) ---
# Локально: docker compose up -d postgres. В проде: строка подключения Neon (pooled).
DATABASE_URL=postgres://memorybook:memorybook@localhost:5432/memorybook
PORT=3000
NODE_ENV=development
# Закрой регистрацию (false), когда создашь свой аккаунт
ALLOW_SIGNUP=true
# Необязательно: без ключа Google Books работает с жёсткими лимитами
GOOGLE_BOOKS_API_KEY=
